# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Elasticsearch
#--------------------------------------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_API_KEY=  # Opcional: para clusters com autenticação

#--------------------------------------------------------------------
# Redis (Clinical Urgency Routing — hot cache HIGH priority)
#--------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=datamed:
REDIS_OPTIONAL=true

#--------------------------------------------------------------------
# CouchDB (espelho state DB — benchmark vs Elasticsearch)
#--------------------------------------------------------------------
COUCHDB_URL=http://localhost:5984
COUCHDB_USERNAME=admin
COUCHDB_PASSWORD=password
COUCHDB_METADATA_DB=fhir_metadata

#--------------------------------------------------------------------
# Hyperledger Fabric (test-network — docs/SETUP.md)
#--------------------------------------------------------------------
FABRIC_MODE=test-network
FABRIC_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_OVERRIDE=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=fhir_chaincode
# FABRIC_CRYPTO_PATH=fabric-samples/test-network/organizations
# SKIP_FABRIC=false
# MICROFAB_URL=http://localhost:8080  # apenas se FABRIC_MODE=microfab